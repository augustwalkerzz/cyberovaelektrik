rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email == 'KAPTAN_MAIL';
    }
    function signed() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.slug;
    }
    function myUnits() {
      return get(/databases/$(database)/documents/people/$(me())).data.units;
    }

    // Kaptanın oluşturduğu kişi kartları (davet kodu burada). Sadece kaptan.
    match /people/{slug} {
      allow read, write: if admin();
    }

    // İsim sahiplenme: doğru kod + isim daha önce alınmamış olmalı.
    match /claims/{slug} {
      allow read, delete: if admin();
      allow create: if signed()
        && !exists(/databases/$(database)/documents/claims/$(slug))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code ==
           get(/databases/$(database)/documents/people/$(slug)).data.code;
    }

    // uid -> hangi kişi. Sadece kendi kaydını görür.
    match /users/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create: if signed() && request.auth.uid == uid
        && get(/databases/$(database)/documents/claims/$(request.resource.data.slug)).data.uid == request.auth.uid;
    }

    // Görevler: üye sadece kendi görevini okur, sadece tik alanını değiştirir.
    match /tasks/{id} {
      allow read: if admin() || (signed() && resource.data.slug == me());
      allow create, delete: if admin();
      allow update: if admin() || (signed() && resource.data.slug == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','doneAt']));
    }

    // Duyurular: herkese / kendi birimine / kendisine.
    match /ann/{id} {
      allow read: if admin() || (signed() && (
        resource.data.target == 'all' ||
        resource.data.target == me() ||
        resource.data.target in myUnits()));
      allow write: if admin();
    }
  }
}
